{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hierro-beta-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {"bindings":[{"name":"PUSH","class_name":"PushScheduler"}]},
  "migrations": [{"tag":"push-v1","new_sqlite_classes":["PushScheduler"]}],
  "vars": { "ALLOWED_ORIGINS": "https://elrobamichis.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hierro-beta-sync",
    "database_id": "58d5c958-6cab-46f2-89e4-469c2012e091"
  }],
  "ratelimits": [
    {"name":"REQUEST_LIMIT","namespace_id":"1001","simple":{"limit":120,"period":60}},
    {"name":"CREATE_LIMIT","namespace_id":"1002","simple":{"limit":5,"period":60}}
  ]
}
