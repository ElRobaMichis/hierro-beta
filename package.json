{
  "name": "hierro-beta",
  "version": "3.4.0",
  "private": true,
  "scripts": {
    "test:sync": "node tests/sync.js && node tests/sync-worker.mjs",
    "sync:dev": "wrangler dev --config sync-worker/wrangler.jsonc --local --port 8787 --var ALLOWED_ORIGINS:http://127.0.0.1:4181,http://localhost:4181",
    "sync:schema:local": "wrangler d1 execute hierro-beta-sync --config sync-worker/wrangler.jsonc --local --file sync-worker/schema.sql",
    "sync:deploy": "wrangler deploy --config sync-worker/wrangler.jsonc"
  },
  "devDependencies": { "wrangler": "4.131.2", "miniflare": "5.20260911.1-alpha" }
}
